      "type": "LinkedServiceReference"
    },
    "parameters": {
      "station": {
        "type": "string",
        "defaultValue": "28"
      },
      "dateKey": {
        "type": "string",
        "defaultValue": "20261104"
      }
    },
    "annotations": ["Source", "REST", "TorqueAPI"],
    "type": "RestResource",
    "typeProperties": {
      "relativeUrl": {
        "value": "@concat('/api/torque-data?station=', dataset().station, '&date=', dataset().dateKey)",
        "type": "Expression"
      }
    },
    "schema": []
  }
}
