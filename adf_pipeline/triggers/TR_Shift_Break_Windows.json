{
  "name": "TR_Shift_Break_Windows",
  "properties": {
    "description": "Fires ADF Pipeline at scheduled line break intervals (10:00, 13:00, 15:00, 16:40 IST) to extract telemetry with zero impact on production line PC",
    "annotations": ["Shift1", "TIEI", "LineBreaks"],
    "type": "ScheduleTrigger",
    "typeProperties": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-11-04T04:30:00Z",
        "timeZone": "India Standard Time",
        "schedule": {
          "hours": [10, 13, 15, 16],
          "minutes": [0, 40]
        }
      }
    },
    "pipelines": [
      {
        "pipelineReference": {
          "referenceName": "PL_Sync_Torque_To_PostgreSQL",
          "type": "PipelineReference"
        },
        "parameters": {
          "shiftDate": "@formatDateTime(trigger().startTime, 'yyyyMMdd')",
          "windowName": "Scheduled Shift Break Window"
        }
      }
    ]
  }
}
