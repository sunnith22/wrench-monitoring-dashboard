# ==============================================================================
# TOYOTA INDUSTRIES ENGINE INDIA (TIEI)
# Environment Configuration Template (.env.example)
# Copy this file to .env on your server and fill in the production credentials.
# ==============================================================================

# Server Network Configuration
PORT=8140
NODE_ENV=production

# Upstream Shop-Floor Controller APIs (Local Line PC)
FINALDB_API_URL=http://10.82.126.73:8121
YOKOTA_API_URL=http://10.82.126.73:8127

# PostgreSQL Database (Engine Tracking & Telemetry Store)
POSTGRES_HOST=10.82.126.27
POSTGRES_PORT=5432
POSTGRES_DB=enginetracking
POSTGRES_USER=tracedb
POSTGRES_PASSWORD=your_postgres_password_here

# MongoDB Database (Asset Register & Fallback Cache)
MONGO_URI=mongodb://10.82.126.73:27017/tnga_wrench_monitoring

# ==============================================================================
# EMAIL NOTIFICATION & SMTP CREDENTIALS (SENSITIVE)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_company_smtp_user@toyota.com
SMTP_PASS=your_company_smtp_password_or_app_key
SMTP_FROM="TNGA Pulse Alert System" <no-reply@toyota-tnga.com>

# Plant Alert Recipients (Comma-separated fallback list)
DEFAULT_ALERT_EMAILS=quality.lead@plant.toyota.com,maintenance.shift1@plant.toyota.com
ALERT_COOLDOWN_MINUTES=10

# Portal Application Deep Links (Embedded in email notifications)
MAIN_DASHBOARD_URL=http://localhost:3010
ADMIN_PORTAL_URL=http://localhost:3020

